<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	REFERENCE ONLY: the entitlement Scripts/configure-links.sh adds to
	Config/Generated/<Target>.entitlements (MobileClient, MacClient,
	CatalystClient, VisionClient) when SWIFTTY_LINK_DOMAINS is set, one
	applinks:<domain> entry per domain (spec.inbox.md §4.4). No target
	references this file, and nothing is added when the variable is unset.

	A real deployment also needs:
	  1. Each domain serving Scripts/make-aasa.sh output at
	     https://<domain>/.well-known/apple-app-site-association.
	  2. Signing with a provisioning profile that has the Associated
	     Domains capability.

	links.example.invalid is a reserved placeholder (RFC 2606/6761) and
	must never be deployed. A locator is not a credential: following a
	link still requires the recipient's own configured host and login.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:links.example.invalid</string>
	</array>
</dict>
</plist>
