<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	TEMPLATE, NOT ENABLED. Universal Links for attention items
	(swiftty-unified-spec.md §9). No target references this file.

	To enable for a real deployment:
	  1. Own a domain and serve /.well-known/apple-app-site-association
	     listing this app's team/bundle IDs and the path "/a/*".
	  2. Set SWIFTTY_LINK_DOMAIN to that domain in Apps/project.yml.
	  3. Merge the key below into the target's entitlements (or point
	     CODE_SIGN_ENTITLEMENTS at a copy) and sign with a provisioning
	     profile that has the Associated Domains capability.

	links.example.invalid is a reserved placeholder (RFC 2606/6761) and
	must never be deployed. A locator is not a credential: following a
	link still requires the recipient's own configured host and login.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:links.example.invalid</string>
	</array>
</dict>
</plist>
