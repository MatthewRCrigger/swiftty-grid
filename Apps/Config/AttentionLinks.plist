<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!--
	Attention deep links (spec.inbox.md §4.4), merged into each direct
	client's generated Info.plist.

	- swiftty://attention/open?ref=<locator> is always registered.
	- SwifttyAssociatedDomains lists the hosts whose
	  https://<domain>/a/<locator> Universal Links the app accepts. It is
	  empty here. Scripts/configure-links.sh (the XcodeGen preGenCommand)
	  copies this file to Config/Generated/AttentionLinks.plist with the
	  domains from SWIFTTY_LINK_DOMAINS for the targets that support
	  Universal Links; TVClient uses this file unchanged.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).attention</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>swiftty</string>
			</array>
		</dict>
	</array>
	<key>SwifttyAssociatedDomains</key>
	<array/>
	<!--
	Nearby Macs browses only this Bonjour type (spec.connection-setup.md
	D3), under the target's NSLocalNetworkUsageDescription.
	-->
	<key>NSBonjourServices</key>
	<array>
		<string>_swiftty._tcp</string>
	</array>
</dict>
</plist>
