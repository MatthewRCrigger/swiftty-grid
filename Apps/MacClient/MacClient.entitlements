<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Native macOS client. The optional app-local PTY launches the user's
	login shell, which an App Sandbox would confine; the app therefore runs
	unsandboxed under the hardened runtime (Developer ID distribution).
	Network client access is declared for clarity and for a future
	sandboxed remote-only variant. No background modes or helper
	installation entitlements: swifttyd is installed separately.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
