# Disposable OpenSSH server for Scripts/test-real-ssh.sh. The fixed helper
# path forwards the bootstrap envelope to the real swifttyd on the Mac.
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache openssh-server openssh-sftp-server socat \
 && ssh-keygen -A \
 && adduser -D -s /bin/sh rst \
 && mkdir -p /usr/local/libexec /home/rst/.ssh \
 && chown rst:rst /home/rst/.ssh && chmod 700 /home/rst/.ssh \
 && printf 'PasswordAuthentication yes\nPubkeyAuthentication yes\nKbdInteractiveAuthentication no\nPermitRootLogin no\nAllowUsers rst\nSubsystem sftp internal-sftp\n' > /etc/ssh/sshd_config.d/10-test.conf
COPY swifttyd-forwarder /usr/local/libexec/swifttyd
COPY entrypoint.sh /entrypoint.sh
RUN chmod 755 /usr/local/libexec/swifttyd /entrypoint.sh
EXPOSE 22
ENTRYPOINT ["/entrypoint.sh"]
