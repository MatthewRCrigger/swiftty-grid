# CI configuration reference for GitHub Actions and Xcode Cloud.
# These workflows do not load .env automatically: configure the variables and
# secrets in the provider indicated below. Ordinary checks in ci.yml require no
# user-provided environment variables or secrets.
#
# For local release scripts, copy this file to .env, fill in the values, then:
#   set -a
#   . ./.env
#   set +a
# .env is gitignored. Keep real credentials out of this example.

# GitHub Actions: required repository variable (Settings > Secrets and variables
# > Actions > Variables). This must match the Developer ID Application identity
# in the signing archive configured below.
# release-mac.yml passes this value to the packaging script as IDENTITY.
DEVELOPER_ID_IDENTITY="Developer ID Application: Your Name (ABCDE12345)"

# GitHub Actions: required repository secrets for the hosted release runner.
# Base64-encode the .p12 export containing BOTH the certificate and private key.
# For example: base64 -i .keys/Certificates.p12 | tr -d '\n'
# The workflow imports it into a temporary keychain and deletes it after use.
MACOS_CERTIFICATE_P12=
MACOS_CERTIFICATE_PASSWORD=

# GitHub Actions: required repository secrets for macOS release notarization.
# NOTARY_KEY_ID: App Store Connect API key ID (e.g. ABC123DE45).
# NOTARY_ISSUER_ID: the API key's issuer UUID.
# NOTARY_KEY: the entire .p8 private key contents, not its path or base64 encoding.
# Use an API key with the Developer role or higher.
NOTARY_KEY_ID=
NOTARY_ISSUER_ID=
NOTARY_KEY=
# For a local .env, preserve actual newlines inside single quotes, for example:
# NOTARY_KEY='-----BEGIN PRIVATE KEY-----
# REPLACE_WITH_YOUR_PRIVATE_KEY_CONTENTS
# -----END PRIVATE KEY-----'

# Xcode Cloud: required workflow environment variable for automatic signing.
# Replace the example with your Apple Developer team ID.
SWIFTTY_TEAM_ID=ABCDE12345

# Optional Universal Links configuration, used by XcodeGen and Mac packaging.
# Set these in the Xcode Cloud workflow or local runner environment;
# release-mac.yml does not export them from GitHub repository variables.
# Comma- or whitespace-separated hostnames, without schemes or paths; for example
# links.example.com,go.example.com. Empty means swiftty:// links only.
SWIFTTY_LINK_DOMAINS=
# Leave empty for distribution. "developer" is for development-signed builds.
SWIFTTY_LINK_MODE=
# Local runner path to a macOS provisioning profile with Associated
# Domains enabled. Needed for Mac Universal Links when domains are configured.
# Xcode Cloud manages provisioning for its own app archives.
SWIFTTY_PROVISIONING_PROFILE=

# Optional CloudKit container for opt-in profile/key-metadata sync
# (spec.ssh-identity.md §8), used by XcodeGen. It must be provisioned for the
# team, with the production schema deployed before TestFlight. Empty builds
# the clients without the iCloud capability; sync is then hidden.
SWIFTTY_CLOUDKIT_CONTAINER=

# Optional alternative for local notarization: an existing notarytool
# keychain profile. Leave the NOTARY_KEY_ID/NOTARY_ISSUER_ID/NOTARY_KEY trio empty
# when using this. The current release workflow explicitly supplies the trio;
# this profile must be available in the environment if using the alternative.
NOTARY_PROFILE=

# Values supplied automatically by GitHub Actions; no custom secrets are needed.
# For a local release, provide a token with repository contents:write permission.
GITHUB_TOKEN=
# GitHub supplies owner/repo; locally an empty value uses the origin remote.
GITHUB_REPOSITORY=

# Local packaging defaults. GitHub overrides these with the pushed version tag
# (or manual workflow version input) and github.run_number, respectively.
SWIFTTY_VERSION=0.2
SWIFTTY_BUILD=1
# GitHub sets this to the pushed tag, or empty for a manual prerelease.
# Locally, empty creates a mac-v<version>-<build> prerelease.
RELEASE_TAG=
# GitHub supplies github.sha; locally an empty value uses HEAD.
RELEASE_COMMIT=

# Xcode Cloud supplies this path. Leave unset locally to use the script's repo.
# CI_PRIMARY_REPOSITORY_PATH=/path/to/checkout
